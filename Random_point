`timescale 1ns / 1ps

module random_point( VGA_clk , rand_x, rand_y );
input VGA_clk;
output reg [9:0]rand_x;
output reg [9:0]rand_y;
reg [7:0] lfsr = 8'hA5;   // Non-zero seed

always @(posedge VGA_clk)
begin
    // Update LFSR
    lfsr <= {lfsr[6:0], lfsr[7] ^ lfsr[5] ^ lfsr[4] ^ lfsr[3]};

    // Generate X coordinate (0–639)
    rand_x <= lfsr % 640;

    // Generate Y coordinate (0–479)
    rand_y <= (lfsr * 3) % 480;
end

endmodule
